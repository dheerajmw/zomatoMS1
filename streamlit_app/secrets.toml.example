# Copy to `.streamlit/secrets.toml` in the repo root when running locally (file is gitignored).

# When "Run API inside Streamlit (embedded)" is on (default), API_BASE_URL is ignored for recommendations.
# Use embedded on Streamlit Cloud so you do not need a separate backend URL.
USE_EMBEDDED_FASTAPI = true

# Only used when embedded is OFF — e.g. local two-process dev with Uvicorn.
API_BASE_URL = "http://127.0.0.1:8000"

# Full-stack page (`streamlit_app/Deployment.py`): HTTPS URL of deployed Next.js (Vercel).
# Local dev iframe: use http://localhost:3000 while Streamlit runs on your machine.
# FRONTEND_URL = "https://your-app.vercel.app"

# Optional: duplicate API env for Cloud if you do not use repo `.env` (see Streamlit README).
# GROQ_API_KEY = "..."
# SKIP_DATASET_LOAD = "false"
