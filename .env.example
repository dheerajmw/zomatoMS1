# Phase 0–1: data
# HF_DATASET=ManikaSaini/zomato-restaurant-recommendation
# DATA_CACHE_PATH=./data/zomato.parquet

# # Phase 2–3: API limits
# MAX_CANDIDATES_K=25
# MAX_RESPONSE_LIMIT=10

# # Phase 4: Groq (optional — without GROQ_API_KEY the API uses deterministic order + template explanations)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# # Shared LLM client tuning (timeout/retries/temperature used by Groq adapter)
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=20000
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.3
# SKIP_DATASET_LOAD=0
# MAX_NOTES_LENGTH=2000

# Next.js dev (architecture §17.2) — comma-separated browser origins for CORS
# CORS_ORIGINS=http://localhost:3000
