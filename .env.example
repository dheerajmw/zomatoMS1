# Copy to `.env` in the repo root (same folder as `pyproject.toml`). Do not commit real secrets.

# --- Phase 0–1: data ---
HF_DATASET=ManikaSaini/zomato-restaurant-recommendation
DATA_CACHE_PATH=./data/zomato.parquet

# --- Phase 2–3: API limits ---
MAX_CANDIDATES_K=25
MAX_RESPONSE_LIMIT=10

# --- Phase 4: Groq (optional — without GROQ_API_KEY the API uses deterministic order + template explanations) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Shared LLM client tuning (timeout / retries / temperature; used by the Groq adapter) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
PROMPT_TEMPLATE_VERSION=v0

# Skip Hugging Face dataset load at API startup (fast local dev). Use true, 1, or yes to enable.
SKIP_DATASET_LOAD=false
MAX_NOTES_LENGTH=2000

# --- Browser CORS (Next.js dev server). Comma-separated origins; include scheme, e.g. http://localhost:3000 ---
CORS_ORIGINS=http://localhost:3000
